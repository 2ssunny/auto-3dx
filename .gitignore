/.vscode
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Scratch directory another local tool writes into.
/.codex/

# pytest basetemp, when a run is given one inside the repo.
/.pytest_temp/

# Local virtual environments, such as a disposable vanilla CPython check.
/.venv*/

# Baselines the live acceptance scripts write between their phases.
/scripts/acceptance/*.baseline.json
